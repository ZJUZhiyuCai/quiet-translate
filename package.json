{
  "name": "quiet-translate",
  "version": "1.1.0",
  "private": true,
  "type": "module",
  "description": "A quiet, BYO-API bilingual reading extension for Chromium and Firefox.",
  "scripts": {
    "test": "node --test tests/*.test.js",
    "check": "node scripts/check.mjs",
    "package": "python scripts/package.py",
    "lint:firefox": "addons-linter dist/firefox --warnings-as-errors",
    "verify": "npm run check && npm test && npm run package",
    "test:chromium": "node scripts/test-chromium.mjs",
    "test:firefox": "node scripts/test-firefox.mjs"
  },
  "license": "MIT",
  "author": "ZJUZhiyuCai",
  "engines": {
    "node": ">=22"
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/ZJUZhiyuCai/quiet-translate.git"
  },
  "homepage": "https://github.com/ZJUZhiyuCai/quiet-translate",
  "bugs": {
    "url": "https://github.com/ZJUZhiyuCai/quiet-translate/issues"
  },
  "keywords": [
    "translation",
    "browser-extension",
    "bilingual",
    "firefox",
    "chromium",
    "byok"
  ],
  "devDependencies": {
    "@playwright/cli": "0.1.22",
    "addons-linter": "10.14.0",
    "selenium-webdriver": "4.51.0"
  }
}
